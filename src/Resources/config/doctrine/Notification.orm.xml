<?xml version="1.0" encoding="UTF-8"?>
<!--
  Nowo\NotifyKitBundle\Domain\Notification (contract 221-B §5.1, the inbox). The table name and the index names get the
  configured doctrine.table_prefix (default "nowo_"), and the identifier columns a binary collation on MySQL / MariaDB,
  through Nowo\NotifyKitBundle\Infrastructure\Doctrine\NotifyKitMetadataListener. A host that registers this file on
  its own entity manager (doctrine.auto_mapping: false) gets the same listener, which applies to every entity manager.
-->
<doctrine-mapping xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xsi:schemaLocation="http://doctrine-project.org/schemas/orm/doctrine-mapping https://www.doctrine-project.org/schemas/orm/doctrine-mapping.xsd">
    <entity name="Nowo\NotifyKitBundle\Domain\Notification" table="notify_notification" read-only="true">
        <indexes>
            <index name="idx_notify_notification_inbox" columns="recipient_type,recipient_id,read_at,created_at,id"/>
            <index name="idx_notify_notification_repeat" columns="recipient_type,recipient_id,type,target"/>
            <index name="idx_notify_notification_context" columns="context_type,context_id"/>
            <index name="idx_notify_notification_created" columns="created_at"/>
        </indexes>

        <id name="id" type="string" column="id" length="36"/>

        <field name="recipientType" type="string" column="recipient_type" length="32"/>
        <field name="recipientId" type="string" column="recipient_id" length="128"/>
        <field name="type" type="string" column="type" length="64"/>
        <field name="category" type="string" column="category" length="64"/>
        <field name="actorType" type="string" column="actor_type" length="32" nullable="true"/>
        <field name="actorId" type="string" column="actor_id" length="128" nullable="true"/>
        <field name="contextType" type="string" column="context_type" length="32" nullable="true"/>
        <field name="contextId" type="string" column="context_id" length="64" nullable="true"/>
        <field name="target" type="string" column="target" length="128"/>
        <field name="url" type="string" column="url" length="500"/>
        <field name="params" type="json" column="params"/>
        <field name="repeats" type="integer" column="repeats"/>
        <field name="firstCreatedAt" type="datetime_immutable" column="first_created_at"/>
        <field name="createdAt" type="datetime_immutable" column="created_at"/>
        <field name="readAt" type="datetime_immutable" column="read_at" nullable="true"/>
    </entity>
</doctrine-mapping>
