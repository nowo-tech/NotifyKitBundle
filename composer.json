{
    "name": "nowo-tech/notify-kit-bundle",
    "description": "Notifications for Symfony: one notify() call, an in-app inbox with a real-time badge, per-person preferences by category and channel, quiet hours and digests, mail / push / Slack channels and GDPR export and erasure.",
    "type": "symfony-bundle",
    "license": "MIT",
    "keywords": [
        "php",
        "symfony",
        "symfony-bundle",
        "notifications",
        "inbox",
        "bell",
        "preferences",
        "mercure",
        "digest",
        "quiet-hours",
        "ddd",
        "nowo",
        "frankenphp"
    ],
    "homepage": "https://github.com/nowo-tech/NotifyKitBundle",
    "support": {
        "issues": "https://github.com/nowo-tech/NotifyKitBundle/issues",
        "source": "https://github.com/nowo-tech/NotifyKitBundle",
        "docs": "https://github.com/nowo-tech/NotifyKitBundle/tree/main/docs",
        "changelog": "https://github.com/nowo-tech/NotifyKitBundle/blob/main/docs/CHANGELOG.md"
    },
    "authors": [
        {
            "name": "Héctor Franco Aceituno",
            "email": "hectorfranco@nowo.tech",
            "homepage": "https://github.com/HecFranco",
            "role": "Developer"
        },
        {
            "name": "Nowo.tech",
            "homepage": "https://nowo.tech"
        }
    ],
    "require": {
        "php": ">=8.2 <8.6",
        "doctrine/dbal": "^3.9 || ^4.0",
        "doctrine/orm": "^3.3",
        "doctrine/persistence": "^3.4 || ^4.0",
        "nowo-tech/form-kit-bundle": "^2.24",
        "nowo-tech/transaction-contract": "^1.0",
        "nowo-tech/transaction-doctrine": "^1.8.1",
        "nowo-tech/ui-kit-bundle": "^2.68",
        "psr/clock": "^1.0",
        "psr/event-dispatcher": "^1.0",
        "psr/log": "^2.0 || ^3.0",
        "symfony/asset": "^7.4 || ^8.0",
        "symfony/clock": "^7.4 || ^8.0",
        "symfony/config": "^7.4 || ^8.0",
        "symfony/console": "^7.4 || ^8.0",
        "symfony/dependency-injection": "^7.4 || ^8.0",
        "symfony/event-dispatcher": "^7.4 || ^8.0",
        "symfony/form": "^7.4 || ^8.0",
        "symfony/framework-bundle": "^7.4 || ^8.0",
        "symfony/http-foundation": "^7.4 || ^8.0",
        "symfony/http-kernel": "^7.4 || ^8.0",
        "symfony/routing": "^7.4 || ^8.0",
        "symfony/security-core": "^7.4 || ^8.0",
        "symfony/security-csrf": "^7.4 || ^8.0",
        "symfony/service-contracts": "^3.5",
        "symfony/translation": "^7.4 || ^8.0",
        "symfony/twig-bundle": "^7.4 || ^8.0",
        "symfony/uid": "^7.4 || ^8.0",
        "twig/extra-bundle": "^3.12",
        "twig/string-extra": "^3.12",
        "twig/twig": "^3.8"
    },
    "require-dev": {
        "doctrine/doctrine-bundle": "^2.13 || ^3.0",
        "friendsofphp/php-cs-fixer": "^3.0",
        "igor-php/igor-php": "^0.10.1 || ^0.11.0",
        "nowo-tech/audit-kit-bundle": "^2.1",
        "nowo-tech/phpstan-frankenphp": "^1.3",
        "phpstan/extension-installer": "^1.4",
        "phpstan/phpstan": "^2.0",
        "phpstan/phpstan-phpunit": "^2.0",
        "phpstan/phpstan-symfony": "^2.0",
        "phpunit/phpunit": "^11.5",
        "rector/rector": "^2.0",
        "symfony/browser-kit": "^7.4 || ^8.0",
        "symfony/css-selector": "^7.4 || ^8.0",
        "symfony/dom-crawler": "^7.4 || ^8.0",
        "symfony/filesystem": "^7.4 || ^8.0",
        "symfony/mercure": "^0.10",
        "symfony/messenger": "^7.4 || ^8.0",
        "symfony/phpunit-bridge": "^7.4 || ^8.0",
        "symfony/security-bundle": "^7.4 || ^8.0",
        "symfony/yaml": "^7.4 || ^8.0"
    },
    "suggest": {
        "symfony/flex": "For automatic recipe installation",
        "symfony/messenger": "Retention (and, from S4, the channel fan-out) as messages on the host's async transport",
        "nowo-tech/doctrine-deadlock-retry-bundle": "A retrying TransactionRunnerInterface adapter for the bundle's writes (doctrine.transaction_runner)",
        "symfony/mercure-bundle": "Real-time unread badge through a private Mercure update per recipient (realtime.mode: mercure / auto)",
        "symfony/security-bundle": "The inbox page, bell and operator page (web_ui / admin_ui) need a firewall and a logged-in user"
    },
    "conflict": {
        "nowo-tech/audit-kit-bundle": "<2.0",
        "symfony/mercure": "<0.10"
    },
    "autoload": {
        "psr-4": {
            "Nowo\\NotifyKitBundle\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Nowo\\NotifyKitBundle\\Tests\\": "tests/"
        }
    },
    "archive": {
        "exclude": [
            "/.coderabbit.yaml",
            "/.cursor",
            "/.cursorignore",
            "/.githooks",
            "/.github",
            "/.php-cs-fixer.dist.php",
            "/.scripts",
            "/.scrutinizer.yml",
            "/.specify",
            "/.symfony",
            "/build-info.json",
            "/Dockerfile",
            "/Makefile",
            "/demo",
            "/docker-compose.yml",
            "/docs/images",
            "/igor.json",
            "/package.json",
            "/phpstan.neon.dist",
            "/phpunit.xml.dist",
            "/pnpm-lock.yaml",
            "/rector.php",
            "/specs",
            "/src/Resources/assets/tests",
            "/tests",
            "/tsconfig.json",
            "/vite.config.ts",
            "/vitest.config.ts"
        ]
    },
    "extra": {
        "symfony": {
            "bundle": "Nowo\\NotifyKitBundle\\NowoNotifyKitBundle"
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "phpstan/extension-installer": true
        },
        "platform": {
            "php": "8.2.0"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "scripts": {
        "test": "@php -d memory_limit=512M vendor/bin/phpunit --color=always",
        "test-coverage": "@php -d memory_limit=512M vendor/bin/phpunit --color=always --coverage-html coverage --coverage-clover coverage.xml --coverage-text",
        "test-coverage-100": [
            "@test-coverage",
            "php .scripts/check-coverage.php coverage.xml --min-percent=100"
        ],
        "validate-phpdoc": "php .scripts/complete-public-phpdoc.php",
        "cs-check": "php-cs-fixer fix --dry-run --diff",
        "cs-fix": "php-cs-fixer fix",
        "rector": "rector process",
        "rector-dry": "rector process --dry-run --no-progress-bar",
        "phpstan": "phpstan analyse --memory-limit=512M",
        "update": "composer update --no-interaction",
        "validate": "composer validate --strict",
        "qa": [
            "@cs-check",
            "@test"
        ],
        "igor": "igor-php --no-agent ."
    },
    "scripts-descriptions": {
        "test": "Run PHPUnit tests",
        "test-coverage": "Run PHPUnit tests with code coverage",
        "test-coverage-100": "Run test-coverage and fail if statement or element coverage is below 100% (REQ-TEST-003)",
        "validate-phpdoc": "Fail when a class or public method in src/ has no PHPDoc (REQ-CS-001)",
        "cs-check": "Check code style with PHP-CS-Fixer",
        "cs-fix": "Fix code style with PHP-CS-Fixer",
        "rector": "Apply Rector refactoring",
        "rector-dry": "Run Rector in dry-run mode",
        "phpstan": "Run PHPStan static analysis",
        "update": "Update composer.lock (composer update)",
        "validate": "Validate composer.json (composer validate --strict)",
        "qa": "Run all quality assurance checks",
        "igor": "Run Igor FrankenPHP worker-state audit (REQ-CS-008)"
    }
}
