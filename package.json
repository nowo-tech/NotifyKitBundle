{
  "name": "notify-kit-bundle-assets",
  "version": "1.0.0",
  "description": "Browser assets for nowo-tech/notify-kit-bundle (private, not published to npm).",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.32.1",
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "build": "vite build",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "devDependencies": {
    "@hotwired/stimulus": "^3.2.2",
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "^4.1.12",
    "jsdom": "^31.0.1",
    "typescript": "^6.0.3",
    "vite": "^8.3.8",
    "vitest": "^4.1.12"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
